ML_APP_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=
ADMIN_EMAIL=
DATABASE_URL=

# ---------------------------------------------------------------------------
# Correo de acceso (el código de 6 dígitos).
#
# Resend es lo recomendado: una sola API key, sin servidor SMTP.
#   1. Creá la cuenta en https://resend.com
#   2. Verificá el dominio (agregá los registros DNS que te indica).
#   3. Copiá la API key y ponela abajo.
#
# SMTP sigue disponible como alternativa; se usa sólo si no hay RESEND_API_KEY.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=Plataforma <no-reply@tudominio.com>
MAIL_FROM_NAME=Plataforma

# Alternativa por SMTP (sólo si no definís RESEND_API_KEY):
SMTP_URL=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Dominio público de la app. Si no se define, se deduce del request, que es
# lo correcto para Vercel.
ML_PUBLIC_URL=

# Audience esperado del idToken de Google. Si no se define, se usa el client_id
# de la web de Firebase (ver backend/src/services/googleIdentity.js).
GOOGLE_TOKEN_AUDIENCE=