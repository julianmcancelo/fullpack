{
  "name": "mercado-libre-manager",
  "version": "1.0.0",
  "description": "Sistema de gestión integral para Mercado Libre: Stock, Ventas, Logística y Envíos",
  "scripts": {
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "build": "cd frontend && npm run build"
  },
  "keywords": [
    "mercadolibre",
    "ecommerce",
    "stock",
    "shipping",
    "sales"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "morgan": "^1.12.1"
  }
}
